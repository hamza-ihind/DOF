# Persistent PostgreSQL database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
# Prefer a scrypt hash generated with npm run admin:password.
ADMIN_PASSWORD_HASH=
# Optional alternative: a long, unique password. No built-in password exists.
ADMIN_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Defenders of Future <updates@YOUR_VERIFIED_DOMAIN>
# PLACEHOLDER: replace with the actual contact recipient later.
RESEND_TO_EMAIL=YOUR_CONTACT_EMAIL@example.com
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_SECRET=
UPLOADTHING_TOKEN=
# Enable only when the deployment proxy overwrites x-forwarded-for.
TRUST_PROXY=false
